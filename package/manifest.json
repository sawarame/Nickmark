{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.2.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "135",
  "permissions": [
    "omnibox",
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "userScripts",
    "contextMenus",
    "favicon"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "omnibox": {
    "keyword": "nm"
  },
  "options_ui": {
    "page": "list.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "__MSG_commandRegisterBookmark__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}